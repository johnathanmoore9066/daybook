# Copy to .env.local for local development. On Vercel, set these under Project > Settings > Environment Variables.

# Required once deployed. Locally, leaving it empty skips the login screen.
DASHBOARD_PASSWORD=

# Optional. Signs the login cookie; set it so changing the password later doesn't sign you out.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Required for automatic delivery. The agent or Gmail bridge sends this as a Bearer token.
INGEST_TOKEN=

# Optional. Lets Claude Haiku list each report's events and day ratings in your agenda.
ANTHROPIC_API_KEY=

# Optional. Canvas, Blackboard, or D2L calendar feed URL (webcal:// links work too).
SCHOOL_ICS_URL=

# Optional. Defaults to America/New_York.
DASHBOARD_TZ=

# Set automatically when you connect a Vercel Blob store. Leave empty locally to store data in .data/.
BLOB_READ_WRITE_TOKEN=
# Match the store's access setting. Defaults to private.
BLOB_ACCESS=
